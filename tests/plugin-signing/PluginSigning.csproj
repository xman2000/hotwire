<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the plugin's signing code against the panel's published vector, outside the game.
       run.sh copies the "Panel signing" region out of src/Hotwire.cs into Extracted.cs first. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
